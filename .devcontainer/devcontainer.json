{
  "name": "seurat-dev-myst",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "rstudio",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "yzhang.markdown-all-in-one",
        "mystmd.mystmd",
        "REditorSupport.r",
        "ms-vscode.cpptools-extension-pack",
        "fortran-lang.linter-gfortran"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "updateRemoteUserUID": true,
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],
  "containerEnv": {
    "LD_LIBRARY_PATH": "/workspaces/seurat_blog/commands/r-source-4.5.2/lib:${containerEnv:LD_LIBRARY_PATH}"
  },
  "postCreateCommand": "bash .devcontainer/setup-r.sh",

  "forwardPorts": [3000, 3100]
}